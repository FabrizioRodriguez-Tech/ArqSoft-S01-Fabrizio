@model Catalogo.Models.Item

<h1>Agregar Agente</h1>

<form asp-action="Agregar" method="post">
    
    <div>
        <label asp-for="Nombre"></label>
        <input asp-for="Nombre" />
    </div>

    <div>
        <label asp-for="Genero"></label>
        <input asp-for="Genero" />
    </div>

    <div>
        <label asp-for="Origen"></label>
        <input asp-for="Origen" />
    </div>

    <div>
        <label asp-for="Rol"></label>
        <input asp-for="Rol"/>
    </div>

    <div>
        <label asp-for="Descripcion"></label>
        <textarea asp-for="Descripcion"></textarea>
    </div>

    <button type="submit">Guardar</button>
</form>

<hr />

<a asp-action="Index">
    &larr; Cancelar
</a>