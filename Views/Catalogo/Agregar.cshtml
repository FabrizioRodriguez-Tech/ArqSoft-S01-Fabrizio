@model Catalogo.Models.Item
@{
    ViewData["Title"] = "Reclutar Agente";
}

<div id="cinematicContainer" style="display: none;">
    <div class="cinematic-overlay"></div>
    
    <button id="skipBtn" class="btn-skip-cinematic">
        SALTAR <span style="font-size: 0.7rem; margin-left: 5px;">>></span>
    </button>

    <video id="cinematicVideo">
        <source src="/videos/despegue.mp4" type="video/mp4">
        Tu navegador no soporta el protocolo de video.
    </video>
</div>

<div id="uiWrapper" style="@(TempData["AgenteReclutado"] != null ? "display:none;" : "")">
    <div class="radianite-mesh"></div>
    <div class="radianite-overlay"></div>
    
    <div class="content-wrapper">
        <div class="container py-5">
            <div class="row justify-content-center">
                <div class="col-lg-8">
                    
                    <div class="mb-4">
                        <span class="text-white-50 d-block mb-1" style="letter-spacing: 3px; font-size: 0.7rem;">// INICIANDO_PROTOCOLO_DE_RECLUTAMIENTO</span>
                        <h1 class="val-heading m-0">NUEVO RECLUTA</h1>
                    </div>

                    <div class="val-terminal-card">
                        <div class="text-center mb-4">
                            <!-- Contenedor adaptado para usar el CSS de silueta táctica -->
                            <div class="agent-avatar-container mx-auto" id="previewContainer" style="width: 120px; height: 120px; border-radius: 0;">
                                <img id="imgPreview" src="" class="agent-avatar" style="opacity: 0;" />
                            </div>
                            <span class="text-danger small font-valorant d-block mt-2" style="letter-spacing: 2px;">VISTA PREVIA DEL ARCHIVO</span>
                        </div>

                        <form asp-action="Agregar" method="post">
                            <div class="row">
                                <div class="col-md-6 mb-4">
                                    <label asp-for="Nombre" class="val-label-tag">NOMBRE</label>
                                    <input asp-for="Nombre" class="form-control val-control" placeholder="NOMBRE..." required maxlength="20" />
                                </div>

                                <div class="col-md-6 mb-4">
                                    <label asp-for="Rol" class="val-label-tag">ROL</label>
                                    <select asp-for="Rol" class="form-control val-control">
                                        <option value="Duelista">DUELISTA</option>
                                        <option value="Iniciador">INICIADOR</option>
                                        <option value="Controlador">CONTROLADOR</option>
                                        <option value="Centinela">CENTINELA</option>
                                    </select>
                                </div>

                                <div class="col-md-6 mb-4">
                                    <label asp-for="Genero" class="val-label-tag">GÉNERO</label>
                                    <input asp-for="Genero" class="form-control val-control" placeholder="MASCULINO / FEMENINO / NC" />
                                </div>

                                <div class="col-md-6 mb-4">
                                    <label asp-for="Origen" class="val-label-tag">ORIGEN</label>
                                    <input asp-for="Origen" class="form-control val-control" placeholder="TIERRA-616, ETC..." />
                                </div>

                                <div class="col-12 mb-4">
                                    <label class="val-label-tag">URL DE IMAGEN (RECUADRO)</label>
                                    <input name="ImagenUrl" id="urlInput" class="form-control val-control" placeholder="https://..." />
                                </div>

                                <div class="col-12 mb-4">
                                    <label asp-for="Descripcion" class="val-label-tag">DESCRIPCIÓN OPERATIVA</label>
                                    <textarea asp-for="Descripcion" class="form-control val-control" rows="3" placeholder="RESUMEN DE CAPACIDADES..."></textarea>
                                </div>
                            </div>

                            <div class="mt-4 d-flex justify-content-between align-items-center">
                                <a asp-action="Index" class="text-white-50 text-decoration-none" style="font-family: 'Valorant'; font-size: 0.7rem;">&larr; ABORTAR_MISIÓN</a>
                                <button type="submit" class="btn-val-primary">CONFIRMAR RECLUTA</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // --- PREVISUALIZACIÓN TÁCTICA ---
        const input = document.getElementById('urlInput');
        const imgPreview = document.getElementById('imgPreview');

        input.addEventListener('input', function() {
            if (this.value.trim() !== "") {
                imgPreview.src = this.value;
                imgPreview.style.opacity = "1";
            } else {
                imgPreview.src = "";
                imgPreview.style.opacity = "0";
            }
        });

        // --- MOTOR DE CINEMÁTICAS ---
        document.addEventListener("DOMContentLoaded", function() {
            const registroExitoso = '@(TempData["AgenteReclutado"] != null ? "true" : "false")';

            if (registroExitoso === "true") {
                const videoContainer = document.getElementById("cinematicContainer");
                const videoElement = document.getElementById("cinematicVideo");
                const uiWrapper = document.getElementById("uiWrapper");
                const skipBtn = document.getElementById("skipBtn");

                uiWrapper.style.display = "none";
                videoContainer.style.display = "block";

                // Intento de reproducción con audio, fallback a mute si el navegador bloquea
                videoElement.play().catch(error => {
                    videoElement.muted = true;
                    videoElement.play();
                });

                const finalizarYRedirigir = () => {
                    videoElement.style.opacity = "0";
                    setTimeout(() => {
                        window.location.href = '@Url.Action("Index", "Catalogo")';
                    }, 800);
                };

                if(skipBtn) skipBtn.addEventListener("click", finalizarYRedirigir);
                videoElement.onended = finalizarYRedirigir;

                // Fundido automático antes de terminar
                videoElement.ontimeupdate = function() {
                    if (videoElement.duration - videoElement.currentTime <= 0.8) {
                        videoElement.style.opacity = "0";
                    }
                };
            }
        });
    </script>
}