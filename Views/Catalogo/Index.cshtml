@model List<Catalogo.Models.Item>
@{
    ViewData["Title"] = "Agentes";
}

@* Capas de fondo animadas *@
<div class="radianite-mesh"></div>
<div class="radianite-overlay"></div>

<div class="content-wrapper">
    <div class="container mt-4">
        <div class="mb-5">
            <span class="text-white-50 d-block mb-1" style="letter-spacing: 2px; font-size: 0.8rem;">LISTA DE</span>
            <h1 class="val-heading">AGENTES</h1>
        </div>

        @* Filtros *@
        <div class="mb-5 d-flex align-items-center gap-4 flex-wrap">
            <a class="nav-filter @(string.IsNullOrEmpty(Context.Request.Query["genero"]) ? "active" : "")" asp-action="Index">
                <span class="filter-box"></span>
                <span class="filter-text">TODOS</span>
            </a>
            @if (ViewBag.Generos != null)
            {
                foreach (var gen in ViewBag.Generos as List<string>)
                {
                    <a class="nav-filter @(Context.Request.Query["genero"] == gen ? "active" : "")" asp-action="Index" asp-route-genero="@gen">
                        <span class="filter-box"></span>
                        <span class="filter-text">@gen.ToUpper()</span>
                    </a>
                }
            }
        </div>

        @* Lista de Agentes *@
        <div class="row g-3">
            @foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 val-card border-0">
                        <div class="card-body d-flex align-items-center gap-3">
                            
                            @* CONTENEDOR DE IMAGEN CON SILUETA CSS *@
                            <div class="agent-avatar-container @(string.IsNullOrWhiteSpace(item.ImagenUrl) ? "unknown-agent" : "")">
                                @if (!string.IsNullOrWhiteSpace(item.ImagenUrl))
                                {
                                    <img src="@item.ImagenUrl" class="agent-avatar" alt="@item.Nombre" />
                                }
                                else
                                {
                                    @* Silueta técnica minimalista *@
                                    <div class="d-flex flex-column align-items-center justify-content-center h-100 w-100 bg-dark">
                                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="opacity: 0.4; filter: drop-shadow(0 0 5px var(--val-red));">
                                            <path d="M12 12C14.21 12 16 10.21 16 8C16 5.79 14.21 4 12 4C9.79 4 8 5.79 8 8C8 10.21 9.79 12 12 12Z" fill="#ff4655" />
                                            <path d="M12 14C9.33 14 4 15.34 4 18V20H20V18C20 15.34 14.67 14 12 14Z" fill="#ff4655" />
                                        </svg>
                                        <span style="font-size: 0.4rem; color: var(--val-red); margin-top: 4px; letter-spacing: 1px;">MISSING</span>
                                    </div>
                                }
                            </div>

                            <div class="flex-grow-1">
                                <h4 class="h5 mb-1">
                                    <a asp-action="Detalle" asp-route-id="@item.Id" class="text-decoration-none text-white stretched-link">@item.Nombre</a>
                                </h4>
                                <span class="badge bg-danger" style="border-radius: 0; font-size: 0.6rem; letter-spacing: 1px;">@(item.Rol?.ToUpper() ?? "SIN ROL")</span>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="mt-5 mb-5 pb-5 text-center">
            <a asp-action="Agregar" class="btn-val-primary">+ RECLUTAR</a>
        </div>
    </div>
</div>