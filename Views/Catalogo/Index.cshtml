@model List<Catalogo.Models.Item>
@{
    ViewData["Title"] = "Agentes";
}

@* Capas de fondo animadas *@
<div class="radianite-mesh"></div>
<div class="radianite-overlay"></div>

<div class="content-wrapper">
    <div class="container mt-4">
        <div class="mb-5">
            <span class="text-white-50 d-block mb-1" style="letter-spacing: 2px; font-size: 0.8rem;">// BASE_DE_DATOS_ACTUAL</span>
            <h1 class="val-heading">AGENTES</h1>
        </div>

        @* Filtros *@
        <div class="mb-5 d-flex align-items-center gap-4 flex-wrap">
            <a class="nav-filter @(string.IsNullOrEmpty(Context.Request.Query["genero"]) ? "active" : "")" asp-action="Index">
                <span class="filter-box"></span>
                <span class="filter-text">TODOS</span>
            </a>
            @if (ViewBag.Generos != null)
            {
                foreach (var gen in ViewBag.Generos as List<string>)
                {
                    <a class="nav-filter @(Context.Request.Query["genero"] == gen ? "active" : "")" asp-action="Index" asp-route-genero="@gen">
                        <span class="filter-box"></span>
                        <span class="filter-text">@gen.ToUpper()</span>
                    </a>
                }
            }
        </div>

        @* Lista *@
        <div class="row g-3">
            @foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 val-card border-0">
                        <div class="card-body d-flex align-items-center gap-3">
                            <div class="agent-avatar-container">
                                <img src="@item.ImagenUrl" class="agent-avatar" onerror="this.src='/images/v-logo.png';" />
                            </div>
                            <div class="flex-grow-1">
                                <h4 class="h5 mb-1">
                                    <a asp-action="Detalle" asp-route-id="@item.Id" class="text-decoration-none text-white stretched-link">@item.Nombre</a>
                                </h4>
                                <span class="badge bg-danger" style="border-radius: 0; font-size: 0.6rem; letter-spacing: 1px;">@item.Rol.ToUpper()</span>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="mt-5 mb-5 pb-5 text-center">
            <a asp-action="Agregar" class="btn-val-primary">+ RECLUTAR NUEVO AGENTE</a>
        </div>
    </div>
</div>