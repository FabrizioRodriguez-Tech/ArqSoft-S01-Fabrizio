@model List<Catalogo.Models.Item>

<div class="video-background">
    <video autoplay muted loop playsinline id="bgVideo">
        <source src="~/video/background.mp4" type="video/mp4">
    </video>
    <div class="video-overlay"></div>
</div>

<div class="content-wrapper">
    <div class="container mt-4">
        <div class="mb-5">
            <span class="text-white-50 d-block mb-1" style="letter-spacing: 2px; font-size: 0.8rem; text-transform: uppercase;">Sistema de Gestión</span>
            <h1 class="val-heading">Protocolo Valorant</h1>
        </div>

        <div class="mb-5 d-flex align-items-center gap-4 flex-wrap">
            <a class="nav-filter @(Context.Request.Query["genero"] == "" ? "active" : "")" asp-action="Index">
                <span class="filter-box"></span>
                <span class="filter-text">TODOS</span>
            </a>
            @if (ViewBag.Generos != null)
            {
                foreach (var gen in ViewBag.Generos as List<string>)
                {
                    <a class="nav-filter @(Context.Request.Query["genero"] == gen ? "active" : "")" asp-action="Index" asp-route-genero="@gen">
                        <span class="filter-box"></span>
                        <span class="filter-text">@gen.ToUpper()</span>
                    </a>
                }
            }
        </div>

        <div class="row g-3">
            @foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 val-card border-0">
                        <div class="card-body d-flex align-items-center gap-3">
                            <div class="agent-avatar-container">
                                <img src="@item.ImagenUrl" class="agent-avatar" onerror="this.src='https://raw.githubusercontent.com/the-muda-organization/valorant-assets/main/agents/v-logo.png';" />
                            </div>
                            <div class="flex-grow-1">
                                <h3 class="h5 mb-1" style="font-family: 'Valorant', sans-serif;">
                                    <a asp-action="Detalle" asp-route-id="@item.Id" class="text-decoration-none text-white stretched-link">@item.Nombre</a>
                                </h3>
                                <span class="badge bg-danger" style="border-radius: 0; font-size: 0.65rem;">@item.Rol</span>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="mt-5 mb-5">
            <a asp-action="Agregar" class="btn-val-primary">+ RECLUTAR AGENTE</a>
        </div>
    </div>
</div>